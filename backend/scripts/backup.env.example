# BLUEWRITE — Backup configuration template
# Copy to scripts/backup.env and fill in real values. NEVER commit backup.env.

# Password of the least-privilege backup user created by scripts/create-backup-user.sql
BACKUP_DB_PASSWORD=replace_with_backup_user_password

# Admin account used by restore.sh ONLY (restore needs write access)
RESTORE_DB_USER=root
RESTORE_DB_PASSWORD=same_as_DB_PASSWORD_in_backend_.env

# Where dumps are written (relative to backend/)
BACKUP_DIR=backups

# Retention in days
RETENTION_DAYS=7

# GPG recipient (key id or email). Leave empty to disable encryption (not recommended).
# See docs/fixes/backup-recovery.md for key generation commands.
GPG_KEY=
