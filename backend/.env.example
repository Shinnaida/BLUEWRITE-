# BLUEWRITE Backend Environment Variables
# Copy this file to .env and fill in the values.
# Never commit the real .env file.

# Server
PORT=3000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bluewrite_db

# Authentication session
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_COOKIE_NAME=bluewrite.sid
SESSION_MAX_AGE_MS=28800000
ADMIN_SESSION_IDLE_MS=3600000
SESSION_ABSOLUTE_MAX_AGE_MS=28800000

# Optional LAN hardening. Leave blank to allow Admin login from any LAN address.
# Use comma-separated exact IP addresses backed by DHCP reservations/static addressing.
ADMIN_ALLOWED_IPS=
LOGIN_DELAY_THIRD_MS=2000
LOGIN_DELAY_FOURTH_MS=5000

# Officer email verification — Gmail SMTP with a Google App Password.
# Never use the normal Gmail password and never commit the real .env file.
MAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=bluewrite.security@gmail.com
SMTP_APP_PASSWORD=replace_with_google_app_password
SMTP_FROM=BLUEWRITE Security <bluewrite.security@gmail.com>
EMAIL_VERIFICATION_SECRET=replace_with_a_different_long_random_secret
EMAIL_CODE_TTL_MS=300000
EMAIL_RESEND_COOLDOWN_MS=60000
EMAIL_SEND_WINDOW_MS=900000
EMAIL_MAX_SENDS=3
EMAIL_MAX_ATTEMPTS=5

# Google AI Studio / Gemini API (backend only; never place this key in frontend variables)
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=90000
GEMINI_MAX_OUTPUT_TOKENS=1200
GEMINI_RETRY_DELAY_MS=750

# Ollama (local AI — used instead of Gemini when reachable)
# The model must exist locally: run `ollama pull qwen2.5:3b` first.
# OLLAMA_ONLY=true makes the application use the local model exclusively and
# never contact Google AI Studio (the Gemini integration stays installed).
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_MS=60000
OLLAMA_GENERATE_TIMEOUT_MS=240000
OLLAMA_NUM_PREDICT=1200
OLLAMA_ONLY=false